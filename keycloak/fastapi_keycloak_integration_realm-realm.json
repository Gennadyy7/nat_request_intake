{
  "id": "fastapi_keycloak_integration_realm",
  "realm": "fastapi_keycloak_integration_realm",
  "displayName": "FastAPI Keycloak Integration",
  "enabled": true,
  "sslRequired": "none",
  "registrationAllowed": false,
  "loginWithEmailAllowed": true,
  "duplicateEmailsAllowed": false,
  "resetPasswordAllowed": false,
  "editUsernameAllowed": false,
  "bruteForceProtected": false,
  "roles": {
    "realm": [
      {
        "name": "admin",
        "description": "Administrator",
        "composite": false,
        "clientRole": false,
        "containerId": "fastapi_keycloak_integration_realm"
      },
      {
        "name": "service:email-poller",
        "description": "Email poller service account (B2B NAT intake)",
        "composite": false,
        "clientRole": false,
        "containerId": "fastapi_keycloak_integration_realm"
      },
      {
        "name": "uma_authorization",
        "description": "${role_uma_authorization}",
        "composite": false,
        "clientRole": false,
        "containerId": "fastapi_keycloak_integration_realm"
      },
      {
        "name": "offline_access",
        "description": "${role_offline-access}",
        "composite": false,
        "clientRole": false,
        "containerId": "fastapi_keycloak_integration_realm"
      },
      {
        "name": "default-roles-fastapi_keycloak_integration_realm",
        "description": "${role_default-roles}",
        "composite": true,
        "clientRole": false,
        "containerId": "fastapi_keycloak_integration_realm",
        "composites": {
          "realm": ["offline_access", "uma_authorization"]
        }
      }
    ]
  },
  "clients": [
    {
      "clientId": "fastapi_keycloak_integration_client",
      "name": "NAT API backend",
      "description": "Confidential client for token validation and password grant (e2e)",
      "enabled": true,
      "clientAuthenticatorType": "client-secret",
      "secret": "your-backend-client-secret",
      "redirectUris": [],
      "webOrigins": [],
      "bearerOnly": false,
      "consentRequired": false,
      "standardFlowEnabled": false,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": true,
      "serviceAccountsEnabled": false,
      "publicClient": false,
      "frontchannelLogout": false,
      "protocol": "openid-connect",
      "fullScopeAllowed": true,
      "attributes": {
        "post.logout.redirect.uris": "+"
      },
      "protocolMappers": [
        {
          "name": "realm-roles",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-realm-role-mapper",
          "consentRequired": false,
          "config": {
            "introspection.token.claim": "true",
            "multivalued": "true",
            "userinfo.token.claim": "true",
            "id.token.claim": "true",
            "access.token.claim": "true",
            "claim.name": "roles",
            "jsonType.label": "String"
          }
        }
      ],
      "defaultClientScopes": [
        "web-origins",
        "acr",
        "roles",
        "profile",
        "email"
      ],
      "optionalClientScopes": [
        "address",
        "phone",
        "offline_access",
        "microprofile-jwt"
      ]
    },
    {
      "clientId": "fastapi_keycloak_integration_swagger_client",
      "name": "Swagger UI (NAT intake)",
      "description": "Public client for OAuth2 authorization code + PKCE in intake Swagger",
      "enabled": true,
      "redirectUris": [
        "http://localhost:8000/docs/oauth2-redirect"
      ],
      "webOrigins": [
        "http://localhost:8000",
        "+"
      ],
      "rootUrl": "http://localhost:8000",
      "baseUrl": "/",
      "bearerOnly": false,
      "consentRequired": false,
      "standardFlowEnabled": true,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false,
      "publicClient": true,
      "frontchannelLogout": false,
      "protocol": "openid-connect",
      "fullScopeAllowed": true,
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "post.logout.redirect.uris": "+",
        "oauth2.device.authorization.grant.enabled": "false"
      },
      "protocolMappers": [
        {
          "name": "realm-roles",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-realm-role-mapper",
          "consentRequired": false,
          "config": {
            "introspection.token.claim": "true",
            "multivalued": "true",
            "userinfo.token.claim": "true",
            "id.token.claim": "true",
            "access.token.claim": "true",
            "claim.name": "roles",
            "jsonType.label": "String"
          }
        }
      ],
      "defaultClientScopes": [
        "web-origins",
        "acr",
        "roles",
        "profile",
        "email"
      ],
      "optionalClientScopes": [
        "address",
        "phone",
        "offline_access",
        "microprofile-jwt"
      ]
    },
    {
      "clientId": "email_poller_client",
      "name": "Email poller M2M",
      "description": "Service account for IMAP poller -> POST /api/nat/intake/internal",
      "enabled": true,
      "clientAuthenticatorType": "client-secret",
      "secret": "your-email-poller-client-secret",
      "redirectUris": [],
      "webOrigins": [],
      "bearerOnly": false,
      "consentRequired": false,
      "standardFlowEnabled": false,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": true,
      "authorizationServicesEnabled": false,
      "publicClient": false,
      "frontchannelLogout": false,
      "protocol": "openid-connect",
      "fullScopeAllowed": true,
      "attributes": {
        "post.logout.redirect.uris": "+",
        "oauth2.device.authorization.grant.enabled": "false"
      },
      "protocolMappers": [
        {
          "name": "realm-roles",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-realm-role-mapper",
          "consentRequired": false,
          "config": {
            "introspection.token.claim": "true",
            "multivalued": "true",
            "userinfo.token.claim": "true",
            "id.token.claim": "true",
            "access.token.claim": "true",
            "claim.name": "roles",
            "jsonType.label": "String"
          }
        },
        {
          "name": "nat-api-audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "consentRequired": false,
          "config": {
            "included.client.audience": "fastapi_keycloak_integration_client",
            "id.token.claim": "false",
            "access.token.claim": "true",
            "introspection.token.claim": "true"
          }
        }
      ],
      "defaultClientScopes": [
        "web-origins",
        "acr",
        "roles",
        "profile",
        "email"
      ],
      "optionalClientScopes": [
        "address",
        "phone",
        "offline_access",
        "microprofile-jwt"
      ]
    }
  ],
  "users": [
    {
      "username": "testuser",
      "enabled": true,
      "emailVerified": true,
      "firstName": "Test",
      "lastName": "User",
      "email": "testuser@beltelecom.by",
      "credentials": [
        {
          "type": "password",
          "value": "testpassword",
          "temporary": false
        }
      ],
      "realmRoles": [
        "default-roles-fastapi_keycloak_integration_realm"
      ],
      "clientRoles": {},
      "groups": []
    },
    {
      "username": "admin",
      "enabled": true,
      "emailVerified": true,
      "firstName": "Admin",
      "lastName": "User",
      "email": "admin@beltelecom.by",
      "credentials": [
        {
          "type": "password",
          "value": "adminpasswordexample777",
          "temporary": false
        }
      ],
      "realmRoles": [
        "default-roles-fastapi_keycloak_integration_realm",
        "admin"
      ],
      "clientRoles": {},
      "groups": []
    },
    {
      "username": "service-account-email_poller_client",
      "enabled": true,
      "emailVerified": false,
      "serviceAccountClientId": "email_poller_client",
      "realmRoles": [
        "service:email-poller"
      ],
      "clientRoles": {},
      "groups": []
    }
  ]
}
